{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/testing.ts",
    "tests/*.test.ts",
    "tests/e2e.ts",
    "tests/store-proof.ts",
    "tests/history-proof.ts"
  ],
  "project": ["src/**/*.ts", "examples/**/*.ts", "tests/**/*.ts"],

  "ignoreDependencies": ["@typescript/native-preview", "vite", "jscpd"],

  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
