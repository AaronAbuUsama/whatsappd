{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/testing.ts",
    "tests/*.test.ts",
    "tests/e2e.ts",
    "tests/store-proof.ts",
    "tests/history-proof.ts",
    "tests/operation-replacement-child.ts",
    "tests/operation-states-child.ts",
    "tests/send-guard-proof.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts"],

  "ignoreDependencies": ["@typescript/native-preview", "vite"],

  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
