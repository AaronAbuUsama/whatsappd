{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".github/scripts/*.ts"],
      "project": [".github/scripts/**/*.ts", "examples/**/*.ts"]
    },
    "packages/whatsappd": {
      "entry": ["smoke/*.ts", "src/index.ts", "src/testing.ts", "tests/*.test.ts"],
      "project": ["smoke/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/react": {
      "entry": ["src/index.ts", "tests/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/docs": {
      "entry": ["app/**/*.{ts,tsx}", "source.config.ts", "snippets/*.ts", "tests/*.test.ts"],
      "project": ["**/*.{ts,tsx,mdx,css}"]
    },
    "registry/web": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "registry/opentui": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },

  "ignore": ["examples/web/src/components/ui/**"],

  "ignoreDependencies": [
    "@base-ui/react",
    "@typescript/native-preview",
    "cmdk",
    "date-fns",
    "embla-carousel-react",
    "input-otp",
    "react-day-picker",
    "react-resizable-panels",
    "recharts",
    "use-stick-to-bottom",
    "vaul",
    "vite"
  ],

  "ignoreIssues": {
    "examples/web/src/components/ai-elements/**": ["exports", "types"],
    "examples/web/src/components/ui/**": ["exports", "types"]
  },

  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
