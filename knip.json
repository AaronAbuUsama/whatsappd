{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".github/scripts/*.ts"],
      "project": [".github/scripts/**/*.ts", "examples/**/*.ts"]
    },
    "packages/whatsappd": {
      "entry": ["smoke/*.ts", "src/index.ts", "src/testing.ts", "tests/*.test.ts"],
      "project": ["smoke/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
    }
  },

  "ignoreDependencies": ["@typescript/native-preview", "vite"],

  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
