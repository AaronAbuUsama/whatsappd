{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["proofs/runners/*.ts", "proofs/tests/*.test.ts", "tooling/checks/*.ts"],
      "project": ["examples/**/*.ts", "proofs/**/*.ts", "smoke/**/*.ts", "tooling/**/*.ts"]
    },
    "packages/whatsappd": {
      "entry": ["src/index.ts", "src/testing.ts", "tests/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },

  "ignoreDependencies": ["@typescript/native-preview", "vite"],

  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
