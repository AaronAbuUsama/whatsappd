{
  "name": "@whatsappd/example-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "test": "pnpm --filter whatsappd build && pnpm --filter @whatsappd/react build && node --experimental-strip-types --test tests/*.test.ts",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=true storybook dev -p 6006 --no-open",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=true storybook build -o ../../.artifacts/storybook",
    "test:storybook": "vitest run --project=storybook",
    "test:evidence": "pnpm -w build && playwright test && node --experimental-strip-types e2e/build-evidence-report.ts",
    "test:evidence:open": "pnpm test:evidence && open -a 'Google Chrome' ../../.artifacts/evidence/index.html"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "0.18.0",
    "@shadcn/react": "^0.3.1",
    "@whatsappd/react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "emoji-picker-react": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "whatsappd": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "shadcn": "^4.21.2",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
