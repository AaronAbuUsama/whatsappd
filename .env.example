# Copy to `.env` for your own shell if you want; nothing in whatsappd reads a
# `.env` file. These are plain environment variables, listed here because they
# are the only ones the package and its harnesses consult, and they were
# previously discoverable only by reading the source.
#
# There is no secret among them. WhatsApp credentials are never supplied by
# environment variable — they live behind a `CredentialStore` (`fileStore()`
# writes a private 0600 file; `libsqlBackend()` writes a row), which is why
# there is no token to paste here and no `.env` to leak.

# Level for the default `pino` logger the session builds when `SessionConfig.logger`
# is omitted. Passing your own logger ignores this entirely.
# One of: fatal | error | warn | info | debug | trace | silent
# Default: warn
WA_LOG_LEVEL=warn

# Level for the loggers the test harnesses build. Read by `tests/proof.ts`,
# `tests/e2e.ts`, `tests/store-proof.ts`, and `tests/history-proof.ts` — it has
# no effect on the shipped package.
# `tests/proof.ts` and `tests/history-proof.ts` default to `warn`; `tests/e2e.ts`
# and `tests/store-proof.ts` default to `silent`, since they print their own
# transcript and a protocol trace would bury it.
# Set to `debug` to see the Baileys protocol trace.
LOG_LEVEL=warn

# Where `tests/proof.ts` keeps the credentials from its QR or pairing-code login,
# so a second run resumes instead of asking you to scan again.
# Default: ./.wa-auth (gitignored)
AUTH_DIR=./.wa-auth
