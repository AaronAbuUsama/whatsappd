{
  "name": "whatsappd",
  "version": "0.2.2",
  "description": "A typed WhatsApp session engine with awaited subscriptions and pluggable credential stores.",
  "keywords": [
    "baileys",
    "chatbot",
    "typescript",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot"
  ],
  "homepage": "https://github.com/AaronAbuUsama/whatsappd#readme",
  "bugs": {
    "url": "https://github.com/AaronAbuUsama/whatsappd/issues"
  },
  "license": "MIT",
  "author": "Aaron AbuUsama <security@abuusama.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronAbuUsama/whatsappd.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "vp check",
    "state": "node --experimental-strip-types tests/execution-state.ts",
    "proof": "node --experimental-strip-types tests/proof.ts",
    "proof:pack": "pnpm build && node --experimental-strip-types tests/packed-imports.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@libsql/client": "0.15.15",
    "@types/node": "^25.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@libsql/client": "^0.15.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
