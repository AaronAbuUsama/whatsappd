{
  "name": "whatsappd",
  "version": "0.3.0-alpha.1",
  "description": "A typed WhatsApp session engine with awaited subscriptions and pluggable credential stores.",
  "keywords": [
    "baileys",
    "chatbot",
    "typescript",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot"
  ],
  "homepage": "https://github.com/AaronAbuUsama/whatsappd#readme",
  "bugs": {
    "url": "https://github.com/AaronAbuUsama/whatsappd/issues"
  },
  "license": "MIT",
  "author": "Aaron AbuUsama <security@abuusama.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronAbuUsama/whatsappd.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test tests/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=94 --test-coverage-branches=85 --test-coverage-functions=88 --test tests/*.test.ts",
    "test:report": "node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=94 --test-coverage-branches=85 --test-coverage-functions=88 --test-reporter=tap --test-reporter-destination=test-results.tap --test-reporter=spec --test-reporter-destination=stdout --test tests/*.test.ts",
    "check": "vp check",
    "state": "node --experimental-strip-types tests/execution-state.ts",
    "check:docs": "node --experimental-strip-types tests/docs-references.ts",
    "check:dupes": "jscpd",
    "check:unused": "knip",
    "proof": "node --experimental-strip-types tests/proof.ts",
    "proof:profile": "node --experimental-strip-types tests/proof-profile.ts",
    "proof:client": "node --experimental-strip-types tests/client-proof.ts",
    "proof:client:guard": "node --experimental-strip-types tests/client-guard-proof.ts",
    "proof:client:paging": "node --experimental-strip-types tests/client-proof.ts --paging-replacement",
    "proof:run-a": "node --experimental-strip-types tests/run-a-proof.ts",
    "proof:run-a:diagnose": "node --experimental-strip-types tests/run-a-diagnosis.ts",
    "proof:live-send": "node --experimental-strip-types tests/live-send-proof.ts",
    "proof:pairing": "node --experimental-strip-types tests/pairing-proof.ts",
    "proof:teardown": "node --experimental-strip-types tests/teardown-proof.ts",
    "proof:pack": "pnpm build && node --experimental-strip-types tests/packed-imports.ts",
    "proof:release": "node --experimental-strip-types tests/release-candidate-proof.ts",
    "proof:final-gates": "node --experimental-strip-types tests/final-gates-proof.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@libsql/client": "0.15.15",
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@libsql/client": "^0.15.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
