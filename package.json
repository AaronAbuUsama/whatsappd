{
  "name": "whatsappd-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter whatsappd build",
    "dev": "pnpm --filter whatsappd dev",
    "example:qr": "node --experimental-strip-types examples/qr-cli/index.ts",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test tests/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=94 --test-coverage-branches=85 --test-coverage-functions=88 --test tests/*.test.ts",
    "test:report": "node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=94 --test-coverage-branches=85 --test-coverage-functions=88 --test-reporter=tap --test-reporter-destination=test-results.tap --test-reporter=spec --test-reporter-destination=stdout --test tests/*.test.ts",
    "check": "vp check",
    "state": "node --experimental-strip-types tests/execution-state.ts",
    "check:docs": "node --experimental-strip-types tests/docs-references.ts",
    "check:dupes": "jscpd",
    "check:unused": "knip",
    "proof": "node --experimental-strip-types tests/proof.ts",
    "proof:profile": "node --experimental-strip-types tests/proof-profile.ts",
    "proof:client": "node --experimental-strip-types tests/client-proof.ts",
    "proof:client:guard": "node --experimental-strip-types tests/client-guard-proof.ts",
    "proof:client:paging": "node --experimental-strip-types tests/client-proof.ts --paging-replacement",
    "proof:pack": "pnpm build && node --experimental-strip-types tests/packed-imports.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@libsql/client": "0.15.15",
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "baileys": "7.0.0-rc14",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
