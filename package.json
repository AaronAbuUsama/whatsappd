{
  "name": "whatsappd-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter whatsappd build && pnpm --filter @whatsappd/react build",
    "dev": "pnpm --filter whatsappd dev",
    "docs": "pnpm --filter @whatsappd/docs dev",
    "docs:build": "pnpm build && pnpm --filter @whatsappd/docs build",
    "example:web": "pnpm --filter whatsappd build && pnpm --filter @whatsappd/example-web dev",
    "example:web:build": "pnpm --filter whatsappd build && pnpm --filter @whatsappd/example-web build",
    "example:opentui": "pnpm --filter whatsappd build && pnpm --filter @whatsappd/example-opentui dev",
    "example:qr": "node --experimental-strip-types examples/qr-cli/index.ts",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test packages/whatsappd/tests/*.test.ts packages/react/tests/*.test.ts .github/scripts/*.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude='packages/whatsappd/tests/**' --test-coverage-exclude='.github/**' --test-coverage-lines=94 --test-coverage-branches=85 --test-coverage-functions=88 --test packages/whatsappd/tests/*.test.ts .github/scripts/*.test.ts",
    "test:report": "mkdir -p .artifacts && node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude='packages/whatsappd/tests/**' --test-coverage-exclude='.github/**' --test-coverage-lines=94 --test-coverage-branches=85 --test-coverage-functions=88 --test-reporter=tap --test-reporter-destination=.artifacts/test-results.tap --test-reporter=spec --test-reporter-destination=stdout --test packages/whatsappd/tests/*.test.ts .github/scripts/*.test.ts",
    "check": "pnpm registry:version-check && pnpm build && pnpm --filter @whatsappd/docs typecheck && vp check",
    "state": "node --experimental-strip-types .github/scripts/execution-state.ts",
    "check:docs": "node --experimental-strip-types .github/scripts/check-docs.ts",
    "check:unused": "knip",
    "registry:build": "pnpm --filter @whatsappd/docs registry:build",
    "registry:test": "pnpm --filter @whatsappd/docs test",
    "registry:version-check": "node --experimental-strip-types .github/scripts/sync-registry-version.ts --check",
    "changeset:version": "changeset version && node --experimental-strip-types .github/scripts/sync-registry-version.ts --write",
    "test:pack": "pnpm build && node --experimental-strip-types packages/whatsappd/smoke/packed-consumer.ts && node --experimental-strip-types .github/scripts/packed-renderer-examples.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@oxlint/plugins": "1.72.0",
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "^6.31.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
